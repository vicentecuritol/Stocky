{
  "info": {
    "_postman_id": "stocky-collection-v1",
    "name": "Stocky API",
    "description": "Coleccion de endpoints para el proyecto Stocky - Sistema de inventario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categorias"]
            },
            "description": "Retorna todas las categorias registradas."
          },
          "response": []
        },
        {
          "name": "Buscar categoria por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categorias", "1"]
            },
            "description": "Busca una categoria por id. Devuelve 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Crear categoria",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Abarrotes\",\n  \"descripcion\": \"Productos de almacen general\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categorias"]
            },
            "description": "Crea una categoria nueva. Guarda el id que devuelva para usarlo al crear un producto."
          },
          "response": []
        },
        {
          "name": "Actualizar categoria",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Abarrotes y Conservas\",\n  \"descripcion\": \"Productos de almacen, conservas y enlatados\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categorias", "1"]
            },
            "description": "Actualiza una categoria existente por id. Devuelve 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Eliminar categoria",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categorias", "1"]
            },
            "description": "Elimina una categoria por id. Devuelve 204 si se elimino, 404 si no existia."
          },
          "response": []
        }
      ]
    },
