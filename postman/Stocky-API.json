    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos"]
            },
            "description": "Retorna todos los productos del inventario."
          },
          "response": []
        },
        {
          "name": "Buscar producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "1"]
            },
            "description": "Busca un producto por id. Devuelve 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz Grado 1\",\n  \"precio\": 1500,\n  \"stockActual\": 100,\n  \"stockMinimo\": 10,\n  \"categoriaNombre\": \"Abarrotes\",\n  \"proveedorNombre\": \"Distribuidora Sur\",\n  \"proveedorEmail\": \"contacto@sur.cl\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos"]
            },
            "description": "Crea un producto nuevo. La categoria y proveedor deben existir previamente. El email del proveedor debe coincidir con el registrado."
          },
          "response": []
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz Grado 1 Premium\",\n  \"precio\": 1800,\n  \"stockActual\": 80,\n  \"stockMinimo\": 10,\n  \"categoria\": {\n    \"id\": 1\n  },\n  \"proveedor\": {\n    \"id\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "1"]
            },
            "description": "Actualiza un producto existente. Usa los ids de categoria y proveedor."
          },
          "response": []
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "1"]
            },
            "description": "Elimina un producto por id. Devuelve 204 si se elimino, 404 si no existia."
          },
          "response": []
        },
        {
          "name": "Productos bajo stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/bajo-stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "bajo-stock"]
            },
            "description": "Retorna los productos donde stockActual es menor o igual a stockMinimo. Si todos estan bien abastecidos devuelve lista vacia."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Movimientos",
      "item": [
        {
          "name": "Listar movimientos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos"]
            },
            "description": "Retorna todo el historial de movimientos de stock."
          },
          "response": []
        },
        {
          "name": "Buscar movimiento por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos", "1"]
            },
            "description": "Busca un movimiento por id. Devuelve 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Crear movimiento ENTRADA",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"ENTRADA\",\n  \"cantidad\": 50,\n  \"fecha\": \"2024-01-15T10:00:00\",\n  \"observacion\": \"Reposicion semanal\",\n  \"productoId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos"]
            },
            "description": "Registra una entrada de stock. El tipo debe ser ENTRADA o SALIDA. El producto debe existir. Se manda solo el productoId como numero."
          },
          "response": []
        },
        {
          "name": "Crear movimiento SALIDA",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"SALIDA\",\n  \"cantidad\": 10,\n  \"fecha\": \"2024-01-15T14:30:00\",\n  \"observacion\": \"Despacho a cliente\",\n  \"productoId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos"]
            },
            "description": "Registra una salida de stock. Se manda solo el productoId como numero."
          },
          "response": []
        },
        {
          "name": "Actualizar movimiento",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"ENTRADA\",\n  \"cantidad\": 60,\n  \"fecha\": \"2024-01-15T10:00:00\",\n  \"observacion\": \"Reposicion semanal corregida\",\n  \"producto\": {\n    \"id\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos", "1"]
            },
            "description": "Actualiza un movimiento existente por id."
          },
          "response": []
        },
        {
          "name": "Eliminar movimiento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/movimientos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movimientos", "1"]
            },
            "description": "Elimina un movimiento del historial. Devuelve 204 si se elimino, 404 si no existia."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Clima (Open-Meteo)",
      "item": [
        {
          "name": "Clima actual - Santiago (default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clima",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clima"]
            },
            "description": "Devuelve el clima actual de Santiago de Chile usando Open-Meteo (lat=-33.45, lon=-70.65). No requiere parametros.\n\nEjemplo de respuesta:\n{\n  \"latitude\": -33.45,\n  \"longitude\": -70.65,\n  \"current_weather\": {\n    \"temperature\": 14.5,\n    \"windspeed\": 22.3,\n    \"weathercode\": 3,\n    \"time\": \"2024-01-15T12:00\"\n  }\n}"
          },
          "response": []
        },
        {
          "name": "Clima actual - coordenadas personalizadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clima?lat=-41.47&lon=-72.94",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clima"],
              "query": [
                {
                  "key": "lat",
                  "value": "-41.47",
                  "description": "Latitud (ej: -41.47 para Puerto Montt)"
                },
                {
                  "key": "lon",
                  "value": "-72.94",
                  "description": "Longitud (ej: -72.94 para Puerto Montt)"
                }
              ]
            },
            "description": "Devuelve el clima para coordenadas personalizadas. Puedes cambiar lat y lon por cualquier ciudad del mundo."
          },
          "response": []
        }
      ]
    }
  ],
